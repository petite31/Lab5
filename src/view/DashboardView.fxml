<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="700.0" prefWidth="800.0" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controller.DashboardController">
    <left>
        <VBox prefWidth="250.0" spacing="15.0" style="-fx-background-color: #E8F5E9; -fx-border-color: #C8E6C9; -fx-border-width: 0 1 0 0;" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
            <children>
                <Label fx:id="lblUser" text="Hộp thư của: " textFill="#2e7d32">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                </Label>
                <ListView fx:id="lvEmails" prefHeight="400.0" prefWidth="200.0" style="-fx-background-radius: 10; -fx-border-radius: 10; -fx-control-inner-background: #F1F8E9;" VBox.vgrow="ALWAYS" />
                <Button mnemonicParsing="false" onAction="#handleLogout" prefHeight="35.0" prefWidth="210.0" style="-fx-background-color: #FF8A65; -fx-text-fill: white; -fx-background-radius: 10; -fx-cursor: hand; -fx-font-weight: bold;" text="Đăng xuất" />
            </children>
        </VBox>
    </left>
    <center>
        <VBox spacing="15.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
            </padding>
            <children>
                <Label text="Soạn thư mới" textFill="#388e3c">
                    <font>
                        <Font name="System Bold" size="20.0" />
                    </font>
                </Label>
                <TextField fx:id="txtTo" prefHeight="40.0" promptText="Người nhận..." style="-fx-border-color: #E8F5E9; -fx-border-width: 2; -fx-background-radius: 5; -fx-border-radius: 5;" />
                <TextField fx:id="txtSubject" prefHeight="40.0" promptText="Tiêu đề..." style="-fx-border-color: #E8F5E9; -fx-border-width: 2; -fx-background-radius: 5; -fx-border-radius: 5;" />
                <TextArea fx:id="txtContent" prefHeight="200.0" prefWidth="200.0" promptText="Nội dung email..." style="-fx-border-color: #E8F5E9; -fx-border-width: 2; -fx-background-radius: 5; -fx-border-radius: 5;" VBox.vgrow="ALWAYS" />
                <Button mnemonicParsing="false" onAction="#handleSend" prefHeight="45.0" prefWidth="600.0" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10; -fx-cursor: hand;" text="GỬI EMAIL" VBox.vgrow="ALWAYS" />
            </children>
        </VBox>
    </center>
</BorderPane>